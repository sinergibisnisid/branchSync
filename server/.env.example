# Salin ke .env lalu sesuaikan. Jangan commit file .env.
BS_DATABASE_URL=postgres://branchsync:ganti-sandi@localhost:5432/branchsync?sslmode=disable
# 32 byte base64 — buat dengan: openssl rand -base64 32  (jangan diganti setelah dipakai)
BS_SECRET_KEY=
# URL publik server termasuk prefiks path (dipakai untuk redirect URI OAuth Google)
BS_PUBLIC_URL=http://localhost:8080/v1
BS_ADDR=:8080
# Origin frontend; "null" = frontend dibuka langsung dari file (file://)
BS_ALLOWED_ORIGINS=null,http://localhost:5500
BS_ALLOW_FILE_REDIRECT=true
BS_SESSION_TTL=12h

# Email (OTP & laporan terjadwal). Kosongkan host = email hanya dicatat di log.
BS_SMTP_HOST=
BS_SMTP_PORT=587
BS_SMTP_USER=
BS_SMTP_PASS=
BS_SMTP_FROM=BranchSync <no-reply@bri.co.id>

# Opsional: kredensial OAuth Google (bila kosong, diisi lewat halaman Integrasi Google)
BS_GOOGLE_CLIENT_ID=
BS_GOOGLE_CLIENT_SECRET=
# Token rahasia untuk URL push Pub/Sub: {BS_PUBLIC_URL}/integrations/google/pubsub?token=...
BS_PUBSUB_TOKEN=

BS_SCHEDULER=true
# true = kode OTP dicetak ke log (hanya untuk pengembangan)
BS_DEV=false
