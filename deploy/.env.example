# Salin ke deploy/.env lalu isi. File .env berisi rahasia: jangan di-commit, simpan cadangannya di tempat aman.

# Domain (arahkan record DNS A/AAAA keduanya ke IP server ini sebelum start)
WEB_DOMAIN=branchsync.example.co.id
API_DOMAIN=api.branchsync.example.co.id
# Email untuk Let's Encrypt (pemberitahuan sertifikat)
ACME_EMAIL=admin@example.co.id

# Rahasia — buat sekali, JANGAN diganti setelah dipakai
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32 — mengenkripsi rahasia Google; bila hilang/diganti, Google harus dihubungkan ulang
BS_SECRET_KEY=

# Email untuk kode OTP dan laporan terjadwal (tanpa BS_SMTP_HOST, email hanya dicatat di log)
BS_SMTP_HOST=
BS_SMTP_PORT=587
BS_SMTP_USER=
BS_SMTP_PASS=
BS_SMTP_FROM=BranchSync <no-reply@example.co.id>

# Google (opsional — bisa juga diisi dari halaman Integrasi Google di aplikasi)
BS_GOOGLE_CLIENT_ID=
BS_GOOGLE_CLIENT_SECRET=
# openssl rand -hex 16, bila memakai notifikasi Pub/Sub
BS_PUBSUB_TOKEN=

# Lain-lain
BS_SESSION_TTL=12h
BS_SCHEDULER=true
# Jaringan internal Docker; ganti hanya bila bentrok dengan jaringan server (CADDY_IP harus di dalam APP_SUBNET)
APP_SUBNET=172.30.10.0/24
CADDY_IP=172.30.10.10
